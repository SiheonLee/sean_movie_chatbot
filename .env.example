# ===== 이 파일을 .env 로 복사한 뒤 값을 채우세요 =====
# cp .env.example .env
#
# 값이 비어 있는 항목만 채우면 됩니다. 나머지는 코드의 기본값과 같으니
# 바꿀 이유가 생겼을 때만 건드리세요.

# ---------- Streamlit UI ----------
# 로컬에서는 FastAPI 기본 주소를 사용하고, 배포 시 API 주소만 교체합니다.
RAG_API_URL=http://127.0.0.1:8000

# ---------- 경로 ----------
MOVIES_FILE=data/movies.json
# 무드 프로파일(LLM 결과) 캐시. 임베딩·텍스트 조립을 손볼 때 LLM을 다시 부르지
# 않도록 배치 결과를 여기서 한 번 끊습니다.
ENRICHED_FILE=data/enriched.json
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=movies

# ---------- 검색 ----------
# 도구가 기본으로 돌려줄 영화 편수
TOP_K=4

# ---------- TMDB 수집 ----------
# themoviedb.org → 설정 → API 에서 무료 키 발급
TMDB_API_KEY=
TMDB_LANGUAGE=ko-KR
# 한국 인기작 / 해외 인기·고평점작에서 각각 몇 페이지(페이지당 20편) 수집할지
TMDB_KR_PAGES=8
TMDB_INTL_PAGES=7
# 잔잔한 계열 수집축(드라마·일본·한국·로맨스 평점순)에서 각각 몇 페이지 수집할지.
# 이게 없으면 액션·스릴러가 코퍼스의 67%를 차지해 무드 검색이 무력해집니다.
TMDB_QUIET_PAGES=3
# 최소 투표 수. TMDB의 popularity는 페이지뷰·트래픽 지표라 조회만 많은 작품이
# 상위에 올라옵니다. discover 쿼리에 걸어 애초에 수집하지 않습니다.
TMDB_MIN_VOTE_COUNT=100

# ----------- 웹 검색 ------------
# tavily.com 에서 무료 키 발급
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=3

# ---------- 임베딩 제공자: Google Gemini ----------
EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# 3072차원은 모델 기본 정규화가 적용된다.
GOOGLE_EMBEDDING_DIMENSIONS=3072
# 한 요청에 담을 문서 수. embed_documents는 건수와 무관하게 요청 1건으로 나가므로
# 이 값이 페이로드 크기를 결정합니다. 실측: 50건 성공 / 90건 429.
GOOGLE_EMBEDDING_BATCH_SIZE=50
# 분당 요청 수. 무료 티어 100 RPM보다 여유 있게 두고 429는 자동 재시도합니다.
GOOGLE_EMBEDDING_RPM=90
GOOGLE_EMBEDDING_MAX_RETRIES=5

# ---------- LLM 제공자: anthropic | google ----------
# 도구 호출(bind_tools)이 전제라 이 둘만 지원합니다.
# HuggingFace Endpoint/Pipeline과 Ollama 소형 모델은 도구 호출이 안정적이지
# 않아 그래프가 도구를 아예 못 부르는 상태가 됩니다.
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GOOGLE_MODEL=gemini-2.5-flash
# 도구 선택은 창의성이 필요한 작업이 아니라 0으로 둡니다. 0.1에서도 골든셋이
# 실행할 때마다 다른 케이스에서 실패했습니다.
LLM_TEMPERATURE=0
# 512는 부족합니다. 영화 5편을 소개하면 문장 중간에서 잘립니다(stop_reason=max_tokens).
# 상한이지 목표가 아니라 실제 생성한 만큼만 과금됩니다.
LLM_MAX_TOKENS=2048

# ---------- API 키 ----------
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---------- LangSmith (추적 + 평가) ----------
# 아래 셋은 LangSmith SDK가 환경변수에서 직접 읽습니다(코드가 참조하지 않음).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=movie-rag-langgraph
LANGSMITH_DATASET=movies-rag-eval
EVAL_FILE=eval/dataset.jsonl

# ---------- LangGraph ----------
# 멀티턴 대화 메모리: memory(휘발) | sqlite(파일 영속)
CHECKPOINTER=memory
CHECKPOINT_DB=graph_checkpoints.sqlite
