# ===== 이 파일을 .env 로 복사한 뒤 값을 채우세요 =====
# cp .env.example .env

# ---------- 경로 ----------
MOVIES_FILE=data/movies.json
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=movies

# ---------- 청킹 / 검색 ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
TOP_K=4
# 거리/관련성 필터 전에 가져올 후보 수
RETRIEVAL_FETCH_K=8
# Chroma L2 거리 상한(낮을수록 유사). 임베딩 모델을 바꾸면 평가셋으로 다시 보정
RETRIEVAL_MAX_DISTANCE=1.0

# ---------- TMDB 수집 ----------
# themoviedb.org → 설정 → API 에서 무료 키 발급
TMDB_API_KEY=
TMDB_LANGUAGE=ko-KR
# 한국 인기작 / 해외 인기·고평점작에서 각각 몇 페이지(페이지당 20편) 수집할지
TMDB_KR_PAGES=8
TMDB_INTL_PAGES=7

# ---------- 임베딩 제공자: huggingface | google ----------
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=BAAI/bge-m3
# 나중에 Gemini로 교체할 때:
# EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001

# ---------- LLM 제공자: anthropic | ollama | google | hf_endpoint | hf_pipeline ----------
# anthropic   : Claude API (기본: Claude Haiku 4.5)
# ollama      : 로컬 Ollama 서버
# google      : Gemini (2차, 비교용)
# hf_endpoint : HuggingFace Inference API (HUGGINGFACEHUB_API_TOKEN 필요)
# hf_pipeline : 로컬 transformers (GPU/시간 필요)
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OLLAMA_MODEL=gemma4:e2b-mlx
OLLAMA_BASE_URL=http://localhost:11434
HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
GOOGLE_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512

# ---------- API 키 ----------
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACEHUB_API_TOKEN=

# ---------- LangSmith (요구사항 3: 추적 + 평가) ----------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=movie-rag-langgraph
LANGSMITH_DATASET=movies-rag-eval
EVAL_FILE=eval/dataset.jsonl

# ---------- LangGraph ----------
# 검색결과가 부적합할 때 질의를 재작성해 재검색하는 최대 횟수(무한 루프 방지)
GRAPH_MAX_RETRIES=2
# 검색결과 관련성 평가에 LLM 사용 여부(false 면 문서 존재 여부만으로 판단 → 호출 절약)
GRAPH_GRADE_WITH_LLM=true
# Claude Haiku 4.5는 JSON Schema 구조화 출력을 지원. 미지원 모델은 false
GRAPH_NATIVE_STRUCTURED_OUTPUT=true
# 멀티턴 대화 메모리: memory(휘발) | sqlite(파일 영속)
CHECKPOINTER=memory
CHECKPOINT_DB=graph_checkpoints.sqlite
