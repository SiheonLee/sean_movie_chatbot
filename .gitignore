# 환경 변수 / 비밀키
.env

# 배포에 쓰는 고정 카탈로그만 추적한다. 대화·보관함 등 사용자 데이터는 제외한다.
data/*
!data/movies.json
!data/enriched.json
tmp/

# 배포에 쓰는 Chroma 스냅샷은 추적한다. 갱신은 릴리스 시점에만 수행한다.

# LangGraph sqlite 체크포인터(대화 메모리)
graph_checkpoints.sqlite
*.sqlite
!chroma_db/chroma.sqlite3
*.sqlite-shm
*.sqlite-wal

# 파이썬
__pycache__/
*.pyc
.venv/
.python-version

# 모델 캐시
.cache/

# macOS 잡파일
.DS_Store

